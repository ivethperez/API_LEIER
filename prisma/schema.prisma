generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model category {
  id                            Int          @id @default(autoincrement()) @db.SmallInt
  code                          String       @db.VarChar(50)
  name                          String       @db.VarChar(150)
  categoryTypeId                Int          @db.SmallInt
  active                        Boolean?     @default(true)
  createdAt                     DateTime     @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime?    @db.DateTime(0)
  updatedBy                     Int?
  categoryType                  categoryType @relation(fields: [categoryTypeId], references: [id], onUpdate: Restrict, map: "category_ibfk_1")
  user_category_createdByTouser user         @relation("category_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "category_ibfk_2")
  user_category_updatedByTouser user?        @relation("category_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_ibfk_3")
  expense                       expense[]
  product                       product[]

  @@index([categoryTypeId], map: "categoryTypeId")
  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model categoryType {
  id                                Int        @id @default(autoincrement()) @db.SmallInt
  code                              String     @db.VarChar(50)
  name                              String     @db.VarChar(100)
  createdAt                         DateTime   @db.DateTime(0)
  createdBy                         Int
  updatedAt                         DateTime?  @db.DateTime(0)
  updatedBy                         Int?
  category                          category[]
  user_categoryType_createdByTouser user       @relation("categoryType_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "categoryType_ibfk_1")
  user_categoryType_updatedByTouser user?      @relation("categoryType_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "categoryType_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model customer {
  id                            Int       @id @default(autoincrement())
  name                          String    @db.VarChar(150)
  lastName                      String?   @db.VarChar(150)
  phone                         String?   @db.VarChar(20)
  email                         String?   @db.VarChar(150)
  address                       String?   @db.VarChar(255)
  active                        Boolean?  @default(true)
  createdAt                     DateTime  @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime? @db.DateTime(0)
  updatedBy                     Int?
  user_customer_createdByTouser user      @relation("customer_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "customer_ibfk_1")
  user_customer_updatedByTouser user?     @relation("customer_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_ibfk_2")
  po                            po[]
  sale                          sale[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model expense {
  id                           Int              @id @default(autoincrement())
  name                         String           @db.VarChar(150)
  categoryId                   Int              @db.SmallInt
  expenseTypeId                Int              @db.SmallInt
  active                       Boolean?         @default(true)
  createdAt                    DateTime         @db.DateTime(0)
  createdBy                    Int
  updatedAt                    DateTime?        @db.DateTime(0)
  updatedBy                    Int?
  category                     category         @relation(fields: [categoryId], references: [id], onUpdate: Restrict, map: "expense_ibfk_1")
  expenseType                  expenseType      @relation(fields: [expenseTypeId], references: [id], onUpdate: Restrict, map: "expense_ibfk_2")
  user_expense_createdByTouser user             @relation("expense_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "expense_ibfk_3")
  user_expense_updatedByTouser user?            @relation("expense_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_ibfk_4")
  purchaseDetail               purchaseDetail[]
  warehouseStock               warehouseStock[]

  @@index([createdBy], map: "createdBy")
  @@index([expenseTypeId], map: "expenseTypeId")
  @@index([categoryId], map: "expense_ibfk_1")
  @@index([updatedBy], map: "updatedBy")
}

model expenseType {
  id                               Int       @id @default(autoincrement()) @db.SmallInt
  code                             String    @db.VarChar(50)
  name                             String    @db.VarChar(150)
  active                           Boolean?  @default(true)
  createdAt                        DateTime  @db.DateTime(0)
  createdBy                        Int
  updatedAt                        DateTime? @db.DateTime(0)
  updatedBy                        Int?
  expense                          expense[]
  user_expenseType_createdByTouser user      @relation("expenseType_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "expenseType_ibfk_1")
  user_expenseType_updatedByTouser user?     @relation("expenseType_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenseType_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model paymentMethod {
  id                                 Int       @id @default(autoincrement()) @db.SmallInt
  code                               String    @db.VarChar(50)
  name                               String    @db.VarChar(250)
  active                             Boolean?  @default(true)
  createdAt                          DateTime  @db.DateTime(0)
  createdBy                          Int
  updatedAt                          DateTime? @db.DateTime(0)
  updatedBy                          Int?
  user_paymentMethod_createdByTouser user      @relation("paymentMethod_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "paymentMethod_ibfk_1")
  user_paymentMethod_updatedByTouser user?     @relation("paymentMethod_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "paymentMethod_ibfk_2")
  po                                 po[]
  sale                               sale[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model po {
  id                      Int           @id @default(autoincrement())
  folio                   String        @db.VarChar(150)
  customerId              Int
  paymentMethodId         Int           @db.SmallInt
  totalAmount             Decimal       @db.Decimal(10, 2)
  statusPoId              Int           @db.SmallInt
  orderDate               DateTime      @db.DateTime(0)
  deliveryDate            DateTime?     @db.DateTime(0)
  warehouseId             Int           @db.SmallInt
  createdAt               DateTime      @db.DateTime(0)
  createdBy               Int
  updatedAt               DateTime?     @db.DateTime(0)
  updatedBy               Int?
  customer                customer      @relation(fields: [customerId], references: [id], onUpdate: Restrict, map: "po_ibfk_1")
  paymentMethod           paymentMethod @relation(fields: [paymentMethodId], references: [id], onUpdate: Restrict, map: "po_ibfk_2")
  statusPo                statusPo      @relation(fields: [statusPoId], references: [id], onUpdate: Restrict, map: "po_ibfk_3")
  warehouse               warehouse     @relation(fields: [warehouseId], references: [id], onUpdate: Restrict, map: "po_ibfk_5")
  user_po_createdByTouser user          @relation("po_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "po_ibfk_6")
  user_po_updatedByTouser user?         @relation("po_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "po_ibfk_7")
  poDetail                poDetail[]
  sale                    sale[]

  @@index([createdBy], map: "createdBy")
  @@index([customerId], map: "customerId")
  @@index([paymentMethodId], map: "paymentMethodId")
  @@index([statusPoId], map: "statusPoId")
  @@index([updatedBy], map: "updatedBy")
  @@index([warehouseId], map: "warehouseId")
}

model poDetail {
  id                            Int          @id @default(autoincrement())
  poId                          Int
  productPriceId                Int
  quantity                      Int
  unitPrice                     Decimal      @db.Decimal(10, 2)
  subtotal                      Decimal      @db.Decimal(10, 2)
  createdAt                     DateTime     @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime?    @db.DateTime(0)
  updatedBy                     Int?
  po                            po           @relation(fields: [poId], references: [id], onUpdate: Restrict, map: "poDetail_ibfk_1")
  user_poDetail_createdByTouser user         @relation("poDetail_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "poDetail_ibfk_4")
  user_poDetail_updatedByTouser user?        @relation("poDetail_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "poDetail_ibfk_5")
  productPrice                  productPrice @relation(fields: [productPriceId], references: [id], onUpdate: Restrict, map: "poDetail_ibfk_3")

  @@index([createdBy], map: "createdBy")
  @@index([poId], map: "poId")
  @@index([productPriceId], map: "productPriceId")
  @@index([updatedBy], map: "updatedBy")
}

model priceList {
  id                             Int            @id @default(autoincrement())
  Nombre                         String         @db.VarChar(250)
  supplierId                     Int            @db.SmallInt
  active                         Boolean?       @default(true)
  validFrom                      DateTime       @db.Date
  validTo                        DateTime?      @db.Date
  createdAt                      DateTime       @db.DateTime(0)
  createdBy                      Int
  updatedAt                      DateTime?      @db.DateTime(0)
  updatedBy                      Int?
  user_priceList_createdByTouser user           @relation("priceList_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "priceList_ibfk_3")
  user_priceList_updatedByTouser user?          @relation("priceList_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "priceList_ibfk_4")
  supplier                       supplier       @relation(fields: [supplierId], references: [id], onUpdate: Restrict, map: "priceList_ibfk_5")
  productPrice                   productPrice[]

  @@index([createdBy], map: "createdBy")
  @@index([supplierId], map: "supplierId")
  @@index([updatedBy], map: "updatedBy")
}

model product {
  id                           Int              @id @default(autoincrement())
  name                         String           @db.VarChar(150)
  description                  String           @db.VarChar(500)
  quantity                     Int
  isPiece                      Boolean?         @default(false)
  categoryId                   Int              @db.SmallInt
  active                       Boolean?         @default(true)
  createdAt                    DateTime         @db.DateTime(0)
  createdBy                    Int
  updatedAt                    DateTime?        @db.DateTime(0)
  updatedBy                    Int?
  category                     category         @relation(fields: [categoryId], references: [id], onUpdate: Restrict, map: "product_ibfk_1")
  user_product_createdByTouser user             @relation("product_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "product_ibfk_2")
  user_product_updatedByTouser user?            @relation("product_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_ibfk_3")
  productImage                 productImage[]
  productPrice                 productPrice[]
  warehouseStock               warehouseStock[]

  @@index([createdBy], map: "createdBy")
  @@index([categoryId], map: "product_ibfk_1")
  @@index([updatedBy], map: "updatedBy")
}

model productImage {
  id                                Int       @id @default(autoincrement())
  productId                         Int
  imageUrl                          String    @db.VarChar(500)
  altText                           String?   @db.VarChar(150)
  orderImage                        Int       @db.SmallInt
  active                            Boolean?  @default(true)
  createdAt                         DateTime  @db.DateTime(0)
  createdBy                         Int
  updatedAt                         DateTime? @db.DateTime(0)
  updatedBy                         Int?
  product                           product   @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "productImage_ibfk_1")
  user_productImage_createdByTouser user      @relation("productImage_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "productImage_ibfk_2")
  user_productImage_updatedByTouser user?     @relation("productImage_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "productImage_ibfk_3")

  @@index([createdBy], map: "createdBy")
  @@index([productId], map: "productId")
  @@index([updatedBy], map: "updatedBy")
}

model productPrice {
  id                                Int              @id @default(autoincrement())
  priceListId                       Int?
  productId                         Int
  unitOfMeasureId                   Int              @db.SmallInt
  unitCost                          Decimal?         @db.Decimal(10, 2)
  profitMargin                      Decimal?         @db.Decimal(10, 2)
  unitPrice                         Decimal?         @db.Decimal(10, 2)
  quantity                          Int?
  active                            Boolean?         @default(true)
  createdAt                         DateTime         @db.DateTime(0)
  createdBy                         Int
  updatedAt                         DateTime?        @db.DateTime(0)
  updatedBy                         Int?
  poDetail                          poDetail[]
  product                           product          @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "productPrice_ibfk_1")
  unitOfMeasure                     unitOfMeasure    @relation(fields: [unitOfMeasureId], references: [id], onUpdate: Restrict, map: "productPrice_ibfk_2")
  priceList                         priceList?       @relation(fields: [priceListId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "productPrice_ibfk_3")
  user_productPrice_createdByTouser user             @relation("productPrice_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "productPrice_ibfk_4")
  user_productPrice_updatedByTouser user?            @relation("productPrice_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "productPrice_ibfk_5")
  purchaseDetail                    purchaseDetail[]
  saleDetail                        saleDetail[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
  @@index([priceListId], map: "priceListId")
  @@index([productId], map: "productId")
  @@index([unitOfMeasureId], map: "unitOfMeasureId")
}

model purchase {
  id                            Int              @id @default(autoincrement())
  investmentId                  Int?
  folio                         String           @db.VarChar(100)
  subtotal                      Decimal          @db.Decimal(10, 2)
  total                         Decimal          @db.Decimal(10, 2)
  purchaseDate                  DateTime         @db.DateTime(0)
  createdAt                     DateTime         @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime?        @db.DateTime(0)
  updatedBy                     Int?
  user_purchase_createdByTouser user             @relation("purchase_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "purchase_ibfk_1")
  user_purchase_updatedByTouser user?            @relation("purchase_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchase_ibfk_2")
  investment                    investment?      @relation(fields: [investmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchase_ibfk_3")
  purchaseDetail                purchaseDetail[]

  @@index([createdBy], map: "purchase_ibfk_1")
  @@index([updatedBy], map: "purchase_ibfk_2")
  @@index([investmentId], map: "purchase_ibfk_3")
}

model purchaseDetail {
  id                                  Int           @id @default(autoincrement())
  purchaseId                          Int
  productPriceId                      Int?
  expenseId                           Int?
  supplierId                          Int?          @db.SmallInt
  description                         String?       @db.VarChar(500)
  quantity                            Int
  amountReceived                      Int
  unitCost                            Decimal       @db.Decimal(10, 2)
  subtotal                            Decimal       @db.Decimal(10, 2)
  createdAt                           DateTime      @db.DateTime(0)
  createdBy                           Int
  updatedAt                           DateTime?     @db.DateTime(0)
  updatedBy                           Int?
  purchase                            purchase      @relation(fields: [purchaseId], references: [id], onUpdate: Restrict, map: "purchaseDetail_ibfk_1")
  expense                             expense?      @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchaseDetail_ibfk_3")
  user_purchaseDetail_createdByTouser user          @relation("purchaseDetail_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "purchaseDetail_ibfk_5")
  user_purchaseDetail_updatedByTouser user?         @relation("purchaseDetail_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchaseDetail_ibfk_6")
  supplier                            supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchaseDetail_ibfk_7")
  productPrice                        productPrice? @relation(fields: [productPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchaseDetail_ibfk_8")

  @@index([expenseId], map: "expenseId")
  @@index([purchaseId], map: "purchaseId")
  @@index([createdBy], map: "purchaseDetail_ibfk_4")
  @@index([updatedBy], map: "purchaseDetail_ibfk_5")
  @@index([supplierId], map: "purchaseDetail_ibfk_6")
  @@index([productPriceId], map: "purchaseDetail_ibfk_7")
}

model role {
  id   Int    @id @default(autoincrement()) @db.SmallInt
  code String @db.VarChar(20)
  name String @db.VarChar(50)
  user user[]
}

model sale {
  id                        Int            @id @default(autoincrement())
  folio                     String         @db.VarChar(150)
  poId                      Int?
  customerId                Int?
  paymentMethodId           Int?           @db.SmallInt
  totalAmount               Decimal        @db.Decimal(10, 2)
  statusSaleId              Int            @db.SmallInt
  saleDate                  DateTime       @db.DateTime(0)
  createdAt                 DateTime       @db.DateTime(0)
  createdBy                 Int
  updatedAt                 DateTime?      @db.DateTime(0)
  updatedBy                 Int?
  po                        po?            @relation(fields: [poId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sale_ibfk_1")
  customer                  customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sale_ibfk_2")
  paymentMethod             paymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sale_ibfk_3")
  statusSale                statusSale     @relation(fields: [statusSaleId], references: [id], onUpdate: Restrict, map: "sale_ibfk_4")
  user_sale_createdByTouser user           @relation("sale_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "sale_ibfk_5")
  user_sale_updatedByTouser user?          @relation("sale_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sale_ibfk_6")
  saleDetail                saleDetail[]

  @@index([createdBy], map: "createdBy")
  @@index([customerId], map: "customerId")
  @@index([paymentMethodId], map: "paymentMethodId")
  @@index([poId], map: "poId")
  @@index([statusSaleId], map: "statusSaleId")
  @@index([updatedBy], map: "updatedBy")
}

model statusPo {
  id                            Int       @id @default(autoincrement()) @db.SmallInt
  code                          String    @db.VarChar(50)
  name                          String    @db.VarChar(250)
  active                        Boolean?
  createdAt                     DateTime  @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime? @db.DateTime(0)
  updatedBy                     Int?
  po                            po[]
  user_statusPo_createdByTouser user      @relation("statusPo_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "statusPo_ibfk_1")
  user_statusPo_updatedByTouser user?     @relation("statusPo_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "statusPo_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model statusSale {
  id                              Int       @id @default(autoincrement()) @db.SmallInt
  code                            String    @db.VarChar(50)
  name                            String    @db.VarChar(150)
  active                          Boolean?
  createdAt                       DateTime  @db.DateTime(0)
  createdBy                       Int
  updatedAt                       DateTime? @db.DateTime(0)
  updatedBy                       Int?
  sale                            sale[]
  user_statusSale_createdByTouser user      @relation("statusSale_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "statusSale_ibfk_1")
  user_statusSale_updatedByTouser user?     @relation("statusSale_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "statusSale_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model supplier {
  id                            Int              @id @default(autoincrement()) @db.SmallInt
  name                          String           @db.VarChar(150)
  phone                         String?          @db.VarChar(20)
  email                         String?          @db.VarChar(150)
  address                       String?          @db.VarChar(255)
  active                        Boolean?         @default(true)
  createdAt                     DateTime         @db.DateTime(0)
  createdBy                     Int
  updatedAt                     DateTime?        @db.DateTime(0)
  updatedBy                     Int?
  priceList                     priceList[]
  purchaseDetail                purchaseDetail[]
  user_supplier_createdByTouser user             @relation("supplier_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "supplier_ibfk_1")
  user_supplier_updatedByTouser user?            @relation("supplier_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "supplier_ibfk_2")

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model unitOfMeasure {
  id                                 Int              @id @default(autoincrement()) @db.SmallInt
  code                               String           @db.VarChar(50)
  name                               String           @db.VarChar(150)
  active                             Boolean?         @default(true)
  createdAt                          DateTime         @db.DateTime(0)
  createdBy                          Int
  updatedAt                          DateTime?        @db.DateTime(0)
  updatedBy                          Int?
  productPrice                       productPrice[]
  user_unitOfMeasure_createdByTouser user             @relation("unitOfMeasure_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "unitOfMeasure_ibfk_1")
  user_unitOfMeasure_updatedByTouser user?            @relation("unitOfMeasure_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "unitOfMeasure_ibfk_2")
  warehouseStock                     warehouseStock[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model user {
  id                                            Int              @id @default(autoincrement())
  name                                          String           @db.VarChar(150)
  roleId                                        Int?             @db.SmallInt
  userLeier                                     Boolean          @default(dbgenerated("(b'0')")) @db.Bit(1)
  password                                      String           @db.VarChar(2000)
  phone                                         String?          @db.VarChar(20)
  email                                         String?          @db.VarChar(150)
  active                                        Boolean
  createdAt                                     DateTime         @db.DateTime(0)
  createdBy                                     Int?             @map(" createdBy")
  updatedAt                                     DateTime?        @db.DateTime(0)
  updatedBy                                     Int?
  category_category_createdByTouser             category[]       @relation("category_createdByTouser")
  category_category_updatedByTouser             category[]       @relation("category_updatedByTouser")
  categoryType_categoryType_createdByTouser     categoryType[]   @relation("categoryType_createdByTouser")
  categoryType_categoryType_updatedByTouser     categoryType[]   @relation("categoryType_updatedByTouser")
  customer_customer_createdByTouser             customer[]       @relation("customer_createdByTouser")
  customer_customer_updatedByTouser             customer[]       @relation("customer_updatedByTouser")
  expense_expense_createdByTouser               expense[]        @relation("expense_createdByTouser")
  expense_expense_updatedByTouser               expense[]        @relation("expense_updatedByTouser")
  expenseType_expenseType_createdByTouser       expenseType[]    @relation("expenseType_createdByTouser")
  expenseType_expenseType_updatedByTouser       expenseType[]    @relation("expenseType_updatedByTouser")
  investment_investment_createdByTouser         investment[]     @relation("investment_createdByTouser")
  investment_investment_updatedByTouser         investment[]     @relation("investment_updatedByTouser")
  paymentMethod_paymentMethod_createdByTouser   paymentMethod[]  @relation("paymentMethod_createdByTouser")
  paymentMethod_paymentMethod_updatedByTouser   paymentMethod[]  @relation("paymentMethod_updatedByTouser")
  po_po_createdByTouser                         po[]             @relation("po_createdByTouser")
  po_po_updatedByTouser                         po[]             @relation("po_updatedByTouser")
  poDetail_poDetail_createdByTouser             poDetail[]       @relation("poDetail_createdByTouser")
  poDetail_poDetail_updatedByTouser             poDetail[]       @relation("poDetail_updatedByTouser")
  priceList_priceList_createdByTouser           priceList[]      @relation("priceList_createdByTouser")
