model warehouse {
  id                             Int              @id @default(autoincrement()) @db.SmallInt
  code                           String           @db.VarChar(50)
  name                           String           @db.VarChar(150)
  location                       String           @db.VarChar(255)
  active                         Boolean?         @default(true)
  createdAt                      DateTime         @db.DateTime(0)
  createdBy                      Int
  updatedAt                      DateTime?        @db.DateTime(0)
  updatedBy                      Int?
  po                             po[]
  user_warehouse_createdByTouser user             @relation("warehouse_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "warehouse_ibfk_1")
  user_warehouse_updatedByTouser user?            @relation("warehouse_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "warehouse_ibfk_2")
  warehouseStock                 warehouseStock[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model warehouseStock {
  id                                  Int           @id @default(autoincrement())
  warehouseId                         Int           @db.SmallInt
  productId                           Int?
  expenseId                           Int?
  unitOfMeasureId                     Int           @db.SmallInt
  quantity                            Int
  active                              Boolean?      @default(true)
  createdAt                           DateTime      @db.DateTime(0)
  createdBy                           Int
  updatedAt                           DateTime?     @db.DateTime(0)
  updatedBy                           Int?
  warehouse                           warehouse     @relation(fields: [warehouseId], references: [id], onUpdate: Restrict, map: "warehouseStock_ibfk_1")
  product                             product?      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "warehouseStock_ibfk_2")
  expense                             expense?      @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "warehouseStock_ibfk_3")
  unitOfMeasure                       unitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onUpdate: Restrict, map: "warehouseStock_ibfk_4")
  user_warehouseStock_createdByTouser user          @relation("warehouseStock_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "warehouseStock_ibfk_5")
  user_warehouseStock_updatedByTouser user?         @relation("warehouseStock_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "warehouseStock_ibfk_6")

  @@index([createdBy], map: "createdBy")
  @@index([expenseId], map: "expenseId")
  @@index([productId], map: "productId")
  @@index([unitOfMeasureId], map: "unitOfMeasureId")
  @@index([updatedBy], map: "updatedBy")
  @@index([warehouseId], map: "warehouseId")
}

model investment {
  id                              Int        @id @default(autoincrement())
  amount                          Decimal    @db.Decimal(10, 2)
  description                     String?    @db.VarChar(255)
  investmentDate                  DateTime   @default(now()) @db.DateTime(0)
  createdAt                       DateTime   @default(now()) @db.DateTime(0)
  createdBy                       Int
  updatedAt                       DateTime?  @db.DateTime(0)
  updatedBy                       Int?
  user_investment_createdByTouser user       @relation("investment_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "investment_ibfk_1")
  user_investment_updatedByTouser user?      @relation("investment_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "investment_ibfk_2")
  purchase                        purchase[]

  @@index([createdBy], map: "createdBy")
  @@index([updatedBy], map: "updatedBy")
}

model saleDetail {
  id                              Int          @id @default(autoincrement())
  saleId                          Int
  productPriceId                  Int
  quantity                        Int
  unitPrice                       Decimal      @db.Decimal(10, 2)
  subtotal                        Decimal      @db.Decimal(10, 2)
  createdAt                       DateTime     @db.DateTime(0)
  createdBy                       Int
  updatedAt                       DateTime?    @db.DateTime(0)
  updatedBy                       Int?
  sale                            sale         @relation(fields: [saleId], references: [id], onUpdate: Restrict, map: "saleDetail_ibfk_1")
  productPrice                    productPrice @relation(fields: [productPriceId], references: [id], onUpdate: Restrict, map: "saleDetail_ibfk_2")
  user_saleDetail_createdByTouser user         @relation("saleDetail_createdByTouser", fields: [createdBy], references: [id], onUpdate: Restrict, map: "saleDetail_ibfk_3")
  user_saleDetail_updatedByTouser user?        @relation("saleDetail_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "saleDetail_ibfk_4")

  @@index([createdBy], map: "createdBy")
  @@index([productPriceId], map: "productPriceId")
  @@index([saleId], map: "saleId")
  @@index([updatedBy], map: "updatedBy")
}
